# Environment Variables Template
# Copy this to .env and fill in actual values
# NEVER commit .env to git (add to .gitignore)

# GitHub API
GITHUB_TOKEN=ghp_xxxx...
GITHUB_OWNER=jquitian1-ops
GITHUB_REPO=ticketdesk

# Linear API
LINEAR_API_TOKEN=lin_api_xxxx...

# PostgreSQL (Development)
DATABASE_URL=postgresql://ticketdesk_user:password@localhost:5432/ticketdesk_dev
DATABASE_SSL=false

# PostgreSQL (Neon - Staging/Production)
# DATABASE_URL=postgresql://user:pass@ep-xxxxx.us-east-1.neon.tech/ticketdesk?sslmode=require

# Vercel
VERCEL_TOKEN=xxxxx...
VERCEL_ORG_ID=team_xxxxx
VERCEL_PROJECT_ID=prj_xxxxx

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=development
